<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VocabularyFlashcardsMauiApp.MainPage"
             x:Name="thisPage"
             BindingContext="{x:Reference thisPage}">

    <ScrollView>
        <VerticalStackLayout>
            <CarouselView ItemsSource="{Binding Karty}"
                          IndicatorView="KartyIndicator">
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="50"
                                Padding="50"
                                HeightRequest="250"
                                Stroke="DarkGray"
                                BackgroundColor="Bisque"
                                StrokeShape="RoundRectangle 5"
                                VerticalOptions="Center"
                                HorizontalOptions="Center">
                            <StackLayout>
                                <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Text="{Binding Angielski}"/>
                            </StackLayout>
                        </Border>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
            <IndicatorView x:Name="KartyIndicator"
                           Margin="20"
                           HorizontalOptions="Center"
                           IndicatorColor="Bisque"
                           IndicatorSize="10"/>
            <Button Text="Pokaż tłumaczenie" Command="{Binding Tlumaczenie}"
                    BackgroundColor="Bisque"
                    TextColor="Black"
                    Margin="10"/>
            <Label Text="{Binding TekstT}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   TextColor="Black"
                   IsVisible="{Binding Widoczne}"
                   />
            <Button Text="Zacznij od początku" Command="{Binding Reset}"
                    BackgroundColor="Bisque"
                    TextColor="Black"
                    Margin="10"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
