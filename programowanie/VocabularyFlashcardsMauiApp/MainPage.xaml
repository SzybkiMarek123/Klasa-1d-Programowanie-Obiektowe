<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VocabularyFlashcardsMauiApp.MainPage"
             x:Name="thisPage">
    <ScrollView>
        <VerticalStackLayout Padding="20">
            <CarouselView x:Name="Karuzela"
                          ItemsSource="{Binding Karty}"
                          IndicatorView="{x:Reference KartyIndicator}"
                          CurrentItemChanged="KaruzelaZ">
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="20"
                                Padding="30"
                                HeightRequest="250"
                                Stroke="DarkGray"
                                BackgroundColor="Bisque"
                                StrokeShape="RoundRectangle 5">
                            <Label Text="{Binding Angielski}"
                                   FontAttributes="Bold"
                                   FontSize="28"
                                   TextColor="Black"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
            <IndicatorView x:Name="KartyIndicator"
                           Margin="10"
                           HorizontalOptions="Center"
                           IndicatorColor="Gray"
                           SelectedIndicatorColor="Black"
                           IndicatorSize="10" />
            <Button Text="Pokaż tłumaczenie"
                    Command="{Binding Tlumaczenie}"
                    BackgroundColor="Bisque"
                    TextColor="Black"
                    Margin="10" />
            <Label Text="{Binding TekstT}"
                   IsVisible="{Binding Widoczne}"
                   FontSize="24"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   Margin="10" />
            <Button Text="Zacznij od początku"
                    Command="{Binding Reset}"
                    BackgroundColor="Bisque"
                    TextColor="Black"
                    Margin="10" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
