<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrderCostCalculatorMauiApp.MainPage"
             x:Name="strona"
             Title="OrderCostCalculatorApp"
             BindingContext="{x:Reference strona}">

    <ScrollView>
        <StackLayout Orientation="Vertical">
            <Label Text="Nazwa produktu:"/>
            <Entry Text="{Binding NazwaProduktu, Mode=TwoWay}"/>
            <Label Text="Cena za sztukę:"/>
            <Entry Text="{Binding CenaZaSztuke, Mode=TwoWay}"
                   Keyboard="Numeric"/>
            <Label Text="Liczba sztuk:"/>
            <StackLayout Orientation="Horizontal">
                <Stepper Minimum="1"
                         Maximum="10"
                         Increment="1"
                         Value="{Binding LiczbaSztuk, Mode=TwoWay}"/>
                <Label Text="{Binding LiczbaSztuk}"
                       Margin="10"
                       FontSize="20"/>
            </StackLayout>
            <Picker ItemDisplayBinding="{Binding Nazwa}"
                    ItemsSource="{Binding DostepneDostawy}"
                    SelectedItem="{Binding WybranaDostawa, Mode=TwoWay}"/>
            <Button Text="Oblicz" Command="{Binding PolecenieObliczania}"/>
            <Label Text="{Binding Podsumowanie}"/>
        </StackLayout>
    </ScrollView>
</ContentPage>