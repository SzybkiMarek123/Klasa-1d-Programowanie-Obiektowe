<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrderCostCalculatorMauiApp.MainPage"
             x:Name="thisPage"
             BindingContext="{x:Reference thisPage}">

    <ScrollView>
        <VerticalStackLayout>
            <Label Text="Nazwa produktu:"/>
            <Entry Text="{Binding NazwaProduktu, Mode=TwoWay}"/>
            <Label Text="Cena za sztukę:"/>
            <Entry Text="{Binding CenaZaSztuke, Mode=TwoWay}"/>
            <Label Text="Liczba sztuk:"/>
            <Stepper Minimum="1"
                         Maximum="10"
                         Increment="1"
                         Value="{Binding LiczbaSztuk, Mode=TwoWay}"/>
            <Label Text="{Binding LiczbaSztuk}"/>
            <Label Text="Dostawa ekspresowa (+15 zł):"/>
            <Switch IsToggled="{Binding DostawaEkspresowa, Mode=TwoWay}"/>
            <Button Text="Oblicz"
                    Command="{Binding PolecenieObliczania}"/>
            <Label Text="{Binding Podsumowanie}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>